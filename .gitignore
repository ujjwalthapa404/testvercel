# Dependencies & build output
node_modules/
dist/
dist-ssr/
*.local

# Enforce single package manager (pnpm) — prevent conflicting lockfiles on Vercel
!pnpm-lock.yaml
!pnpm-workspace.yaml
bun.lock
bun.lockb
package-lock.json
yarn.lock

# Ensure application source and HTML entry point are always tracked
!index.html
!src/
!src/**

# Vercel & deployment artifacts
.vercel/

# Environment variables & local secrets (keep .env.example tracked)
.env
.env.*
!.env.example

# Local AI Studio Firebase config (use VITE_FIREBASE_* env vars in Vercel)
firebase-applet-config.json

# Logs & OS files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.DS_Store
Thumbs.db
