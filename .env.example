# Capitol Hill College — Vercel Production Environment Variables
# Configure these variables privately in Vercel Project Settings -> Environment Variables.
# Leave blank if deploying the public website without live Firebase Portal sync (automatic local fallback is built in).

VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID="(default)"

# Optional: Primary administrator email matching firestore.rules
VITE_BOOTSTRAPPED_ADMIN_EMAIL=""
